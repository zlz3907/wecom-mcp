# Non-secret example. Use only with the reviewed build that supports a single
# TEAM_MCP_PUBLIC_URL instance prefix and emits RFC 9728 metadata URLs.
TEAM_MCP_PUBLIC_URL=https://mcp.jyiai.com/zhyczoop
TEAM_MCP_LISTEN_ADDR=127.0.0.1:7702
TEAM_MCP_MAX_CONCURRENT_TOOLS=2

TEAM_MCP_OIDC_ISSUER=<OWNER_PROVIDED_HTTPS_ISSUER>
TEAM_MCP_OIDC_AUDIENCE=<OWNER_PROVIDED_ZHYCZOOP_AUDIENCE>
TEAM_MCP_ACCESS_TOKEN_CLAIM=<OWNER_PROVIDED_ACCESS_TOKEN_CLAIM>
TEAM_MCP_ACCESS_TOKEN_VALUE=<OWNER_PROVIDED_ACCESS_TOKEN_VALUE>
TEAM_MCP_ROLES_CLAIM=<OWNER_PROVIDED_ROLES_CLAIM>
TEAM_MCP_READER_ROLE=<OWNER_PROVIDED_READER_ROLE>
TEAM_MCP_OPERATOR_ROLE=<OWNER_PROVIDED_OPERATOR_ROLE>
TEAM_MCP_ADMIN_ROLE=<OWNER_PROVIDED_ADMIN_ROLE>
TEAM_MCP_REQUIRED_SCOPES=

TEAM_MCP_AUDIT_HMAC_KEY=<PROTECTED_SECRET_INJECTION>
GNAS_BASE_URL=<PROTECTED_SECRET_INJECTION>
GNAS_APP_ID=<PROTECTED_SECRET_INJECTION>
GNAS_APP_SECRET=<PROTECTED_SECRET_INJECTION>
