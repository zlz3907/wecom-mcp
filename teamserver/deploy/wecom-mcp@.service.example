[Unit]
Description=Guomai Aite WeCom MCP instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wecom-mcp-%i
Group=wecom-mcp-%i
EnvironmentFile=/etc/wecom-mcp/%i.env
Environment=GOMEMLIMIT=512MiB
Environment=GOGC=75
ExecStart=/home/product/services/mcp/wecom/current/wecom-mcp-team --config /home/product/services/mcp/wecom/instances/%i/config/instance.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
OOMPolicy=stop

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/home/product/services/mcp/wecom/instances/%i/data

MemoryHigh=500M
MemoryMax=600M
TasksMax=48
LimitNOFILE=4096
CPUQuota=75%

[Install]
WantedBy=multi-user.target
