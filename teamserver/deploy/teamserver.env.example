# Public endpoint presented to WorkBuddy. Production must use HTTPS.
TEAM_MCP_PUBLIC_URL=https://mcp.example.com

# Existing organization OIDC issuer and the audience assigned to this MCP.
TEAM_MCP_OIDC_ISSUER=https://login.example.com
TEAM_MCP_OIDC_AUDIENCE=guomai-aite-wecom-team-mcp

# Required access-token discriminator from the organization's IdP contract.
# These example values match providers that issue token_use=access. Adjust both
# values to the actual JWT access-token claim; ID tokens must not match.
TEAM_MCP_ACCESS_TOKEN_CLAIM=token_use
TEAM_MCP_ACCESS_TOKEN_VALUE=access

# Dot-separated nested claims are supported, for example realm_access.roles.
TEAM_MCP_ROLES_CLAIM=roles
TEAM_MCP_READER_ROLE=wecom-mcp-reader
TEAM_MCP_OPERATOR_ROLE=wecom-mcp-operator
TEAM_MCP_ADMIN_ROLE=wecom-mcp-admin

# Optional comma/space-separated scopes. Roles remain mandatory even when empty.
TEAM_MCP_REQUIRED_SCOPES=

# Generate an independent random value of at least 32 bytes in the protected
# environment. It keys pseudonymous audit subject identifiers and is a secret.
TEAM_MCP_AUDIT_HMAC_KEY=

# Application-level upper bound for simultaneous business tool calls (1..256).
TEAM_MCP_MAX_CONCURRENT_TOOLS=16

# systemd listens on loopback behind Caddy. A container listening on 0.0.0.0
# must also set TEAM_MCP_BEHIND_TLS_PROXY=true.
TEAM_MCP_LISTEN_ADDR=127.0.0.1:17801

# Inject real GNAS values through a protected environment file or secret store.
# Never commit the values or paste them into chat/log output.
GNAS_BASE_URL=https://gnas.example.com
GNAS_APP_ID=
GNAS_APP_SECRET=
