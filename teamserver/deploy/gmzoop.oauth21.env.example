# OAuth 2.1 candidate. Install only as root:root 0600 after GNAS approval.
TEAM_MCP_PUBLIC_URL=https://mcp.jyiai.com/gmzoop
TEAM_MCP_LISTEN_ADDR=127.0.0.1:7702
TEAM_MCP_AUTH_MODE=oauth21

# Browser clients discover GNAS from protected-resource metadata. Public
# clients use organization preregistration or an administrator-allowlisted
# HTTPS CIMD client_id; they never receive the credentials below. These
# confidential resource-server credentials remain only on the gmzoop server.
TEAM_MCP_OIDC_ISSUER=https://jyiai.com/gnas/oauth
TEAM_MCP_OIDC_AUDIENCE=https://mcp.jyiai.com/gmzoop/mcp
TEAM_MCP_OAUTH21_INTROSPECTION_URL=https://jyiai.com/gnas/oauth/introspect
TEAM_MCP_OAUTH21_CLIENT_ID=<PROTECTED_GMZOOP_RESOURCE_SERVER_CLIENT_ID>
TEAM_MCP_OAUTH21_CLIENT_SECRET=<PROTECTED_RANDOM_32_BYTE_OR_LONGER_VALUE>
TEAM_MCP_AUTHZ_TENANT=<PROTECTED_CANONICAL_GM_TENANT_KEY>
TEAM_MCP_AUTHZ_RESOURCE=gmzoop
TEAM_MCP_REQUIRED_SCOPES=zoop.read

TEAM_MCP_AUDIT_HMAC_KEY=<PROTECTED_RANDOM_32_BYTE_OR_LONGER_VALUE>
TEAM_MCP_MAX_CONCURRENT_TOOLS=2

# Existing server-to-WeCom application identity; never sent to the AI client.
GNAS_BASE_URL=https://jyiai.com
GNAS_APP_ID=<PROTECTED_GMZOOP_SERVICE_APP_ID>
GNAS_APP_SECRET=<PROTECTED_GMZOOP_SERVICE_APP_SECRET>
