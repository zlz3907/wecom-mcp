# Public endpoint presented to WorkBuddy. Production must use HTTPS.
TEAM_MCP_PUBLIC_URL=https://mcp.jyiai.com/gmzoop

# Existing organization OIDC issuer and the audience assigned to this MCP.
TEAM_MCP_OIDC_ISSUER=<OWNER_PROVIDED_HTTPS_ISSUER>
TEAM_MCP_OIDC_AUDIENCE=<OWNER_PROVIDED_GMZOOP_AUDIENCE>

# Required access-token discriminator from the organization's IdP contract.
# These example values match providers that issue token_use=access. Adjust both
# values to the actual JWT access-token claim; ID tokens must not match.
TEAM_MCP_ACCESS_TOKEN_CLAIM=<OWNER_PROVIDED_ACCESS_TOKEN_CLAIM>
TEAM_MCP_ACCESS_TOKEN_VALUE=<OWNER_PROVIDED_ACCESS_TOKEN_VALUE>

# Dot-separated nested claims are supported, for example realm_access.roles.
TEAM_MCP_ROLES_CLAIM=<OWNER_PROVIDED_ROLES_CLAIM>
TEAM_MCP_READER_ROLE=<OWNER_PROVIDED_READER_ROLE>
TEAM_MCP_OPERATOR_ROLE=<OWNER_PROVIDED_OPERATOR_ROLE>
TEAM_MCP_ADMIN_ROLE=<OWNER_PROVIDED_ADMIN_ROLE>

# Optional comma/space-separated scopes. Roles remain mandatory even when empty.
TEAM_MCP_REQUIRED_SCOPES=

# Generate an independent random value of at least 32 bytes in the protected
# environment. It keys pseudonymous audit subject identifiers and is a secret.
TEAM_MCP_AUDIT_HMAC_KEY=<PROTECTED_SECRET_INJECTION>

# Application-level upper bound for simultaneous business tool calls (1..256).
TEAM_MCP_MAX_CONCURRENT_TOOLS=2

# Candidate per-user authorization gate. Keep false until GNAS has delivered a
# stable ResolveAuthorizationV1 contract, protected service authentication,
# and independent quality evidence. Rollback is setting this to false and
# restarting the candidate service; static OIDC role enforcement remains.
TEAM_MCP_USER_AUTHZ_ENABLED=false

# Required only after the feature gate is approved. Both GNAS URLs must use the
# same protected HTTPS origin. The Service app secret remains in this root-only
# environment file and is sent only in the JSON body of getJwtToken.
# TEAM_MCP_AUTHZ_RESOLVE_URL=https://<GNAS_INTERNAL_ORIGIN>/gnas/service/resolveAuthorizationV1
# TEAM_MCP_GNAS_SERVICE_TOKEN_URL=https://<GNAS_INTERNAL_ORIGIN>/gnas/service/getJwtToken
# TEAM_MCP_GNAS_SERVICE_APP_ID=<PROTECTED_GMZOOP_CALLER_APP_ID>
# TEAM_MCP_GNAS_SERVICE_APP_SECRET=<PROTECTED_GMZOOP_CALLER_APP_SECRET>
# TEAM_MCP_AUTHZ_TENANT=<FIXED_TENANT_KEY>
# TEAM_MCP_AUTHZ_RESOURCE=gmzoop
# TEAM_MCP_WECOM_USERID_CLAIM=<OIDC_STABLE_WECOM_USERID_CLAIM>
# TEAM_MCP_GNAS_PRINCIPAL_ASSERTION_CLAIM=<OIDC_GNAS_SIGNED_ASSERTION_CLAIM>

# Authorization results are never cached. Every tools/list and tools/call uses
# a fresh ResolveAuthorizationV1 request under a fixed two-second deadline.

# gmzoop listens only on loopback behind Nginx.
TEAM_MCP_LISTEN_ADDR=127.0.0.1:7702

# Inject real GNAS values through a protected environment file or secret store.
# Never commit the values or paste them into chat/log output.
GNAS_BASE_URL=<PROTECTED_SECRET_INJECTION>
GNAS_APP_ID=<PROTECTED_SECRET_INJECTION>
GNAS_APP_SECRET=<PROTECTED_SECRET_INJECTION>
