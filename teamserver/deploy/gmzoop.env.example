# Public endpoint presented to WorkBuddy. Production must use HTTPS.
TEAM_MCP_PUBLIC_URL=https://mcp.jyiai.com/gmzoop

# Existing organization OIDC issuer and the audience assigned to this MCP.
# These are identity-provider facts, not app_info fields, and cannot be guessed.
TEAM_MCP_OIDC_ISSUER=<OWNER_PROVIDED_HTTPS_ISSUER>
TEAM_MCP_OIDC_AUDIENCE=<OWNER_PROVIDED_GMZOOP_AUDIENCE>

# Required access-token discriminator from the organization's IdP contract.
# These example values match providers that issue token_use=access. Adjust both
# values to the actual JWT access-token claim; ID tokens must not match.
TEAM_MCP_ACCESS_TOKEN_CLAIM=<OWNER_PROVIDED_ACCESS_TOKEN_CLAIM>
TEAM_MCP_ACCESS_TOKEN_VALUE=<OWNER_PROVIDED_ACCESS_TOKEN_VALUE>

# The standard role claim and values below are built-in defaults and need no
# environment variables: roles, wecom-mcp-reader, wecom-mcp-operator,
# wecom-mcp-admin. Set TEAM_MCP_ROLES_CLAIM / *_ROLE only when the IdP differs.

# Generate an independent random value of at least 32 bytes in the protected
# environment. It keys pseudonymous audit subject identifiers and is a secret.
TEAM_MCP_AUDIT_HMAC_KEY=<PROTECTED_SECRET_INJECTION>

# Application-level upper bound for simultaneous business tool calls (1..256).
TEAM_MCP_MAX_CONCURRENT_TOOLS=2

# gmzoop listens only on loopback behind Nginx.
TEAM_MCP_LISTEN_ADDR=127.0.0.1:7702

# One dedicated GNAS app_info identity serves both fixed-route WeCom access and
# ResolveAuthorizationV1. The server still obtains its Service JWT using this
# protected app identity; app_info is the source of its enabled routes.
GNAS_BASE_URL=https://jyiai.com
GNAS_APP_ID=<PROTECTED_SECRET_INJECTION>
GNAS_APP_SECRET=<PROTECTED_SECRET_INJECTION>

# Team MCP authorization: enabled for this gmzoop deployment. The resolver and
# Service-JWT URLs are derived from GNAS_BASE_URL, its caller credentials reuse
# GNAS_APP_ID/GNAS_APP_SECRET, and resource defaults to the /gmzoop URL prefix.
# Only the GNAS tenant key and IdP's verified user claims remain deployment
# facts. Do not substitute a route, display name, phone, openid, or user input.
TEAM_MCP_USER_AUTHZ_ENABLED=true
TEAM_MCP_AUTHZ_TENANT=<OWNER_PROVIDED_GNAS_TENANT_KEY>
TEAM_MCP_WECOM_USERID_CLAIM=<OWNER_PROVIDED_STABLE_WECOM_USERID_CLAIM>
TEAM_MCP_GNAS_PRINCIPAL_ASSERTION_CLAIM=<OWNER_PROVIDED_GNAS_SIGNED_ASSERTION_CLAIM>

# Authorization results are never cached. Every tools/list and tools/call uses
# a fresh ResolveAuthorizationV1 request under a fixed two-second deadline.
