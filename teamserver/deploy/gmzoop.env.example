# WorkBuddy Enterprise custom connector: API Key test mode.
# Store this file only at /etc/wecom-mcp/gmzoop.env as root:root 0600.

# Public endpoint and local-only backend address are fixed for gmzoop.
TEAM_MCP_PUBLIC_URL=https://mcp.jyiai.com/gmzoop
TEAM_MCP_LISTEN_ADDR=127.0.0.1:7702

# WorkBuddy Connector Manager: choose API Key, set Header Name to Authorization,
# and set Header Value to "Bearer <the same protected value>". This is one
# connector service identity. Set its static MCP role explicitly; admin exposes
# every tool implemented by this binary, while fixed-tenant business gates still
# apply. It is not a per-user identity and cannot enable MCP per-user authorization.
TEAM_MCP_AUTH_MODE=connector_api_key
TEAM_MCP_CONNECTOR_API_KEY=<PROTECTED_RANDOM_32_BYTE_OR_LONGER_VALUE>
TEAM_MCP_CONNECTOR_ROLE=admin
TEAM_MCP_USER_AUTHZ_ENABLED=false

# Pseudonymous request audit; inject a separate random value of at least 32 bytes.
TEAM_MCP_AUDIT_HMAC_KEY=<PROTECTED_RANDOM_32_BYTE_OR_LONGER_VALUE>
TEAM_MCP_MAX_CONCURRENT_TOOLS=2

# The dedicated GNAS app_info identity remains the server's identity for the
# fixed-route Enterprise WeCom calls. Its secret never enters WorkBuddy.
GNAS_BASE_URL=https://jyiai.com
GNAS_APP_ID=<PROTECTED_GMZOOP_SERVICE_APP_ID>
GNAS_APP_SECRET=<PROTECTED_GMZOOP_SERVICE_APP_SECRET>
